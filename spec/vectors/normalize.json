{
  "description": "Domain parameter normalization and validation (SPEC.md §2). expect.ok=true → expect.domain is the normalized value; expect.ok=false → expect.error_code is the 400 error code.",
  "vectors": [
    { "id": "N-01", "rules": ["IN-1"], "input": null, "expect": { "ok": false, "error_code": "missing_domain" } },
    { "id": "N-02", "rules": ["IN-1"], "input": "", "expect": { "ok": false, "error_code": "missing_domain" } },
    { "id": "N-03", "rules": ["IN-1", "IN-2"], "input": "   ", "expect": { "ok": false, "error_code": "missing_domain" } },
    { "id": "N-04", "rules": ["IN-2"], "input": "  Example.COM  ", "expect": { "ok": true, "domain": "example.com" } },
    { "id": "N-05", "rules": ["IN-2"], "input": "example.com.", "expect": { "ok": true, "domain": "example.com" } },
    { "id": "N-06", "rules": ["IN-2", "IN-6"], "input": "example.com..", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-07", "rules": ["IN-3", "IN-8"], "input": "https://example.com", "expect": { "ok": false, "error_code": "invalid_domain", "message_contains": ["bare domain"] } },
    { "id": "N-08", "rules": ["IN-3"], "input": "example.com/path", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-09", "rules": ["IN-3"], "input": "example.com:25", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-10", "rules": ["IN-3"], "input": "user@example.com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-11", "rules": ["IN-3"], "input": "exa mple.com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-12", "rules": ["IN-3"], "input": "example.com?x=1", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-13", "rules": ["IN-3"], "input": "example.com#frag", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-14", "rules": ["IN-4"], "input": "münchen.de", "expect": { "ok": true, "domain": "xn--mnchen-3ya.de" } },
    { "id": "N-15", "rules": ["IN-4"], "input": "xn--mnchen-3ya.de", "expect": { "ok": true, "domain": "xn--mnchen-3ya.de" } },
    { "id": "N-16", "rules": ["IN-5"], "input": "192.0.2.1", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-17", "rules": ["IN-5", "IN-3"], "input": "[2001:db8::1]", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-18", "rules": ["IN-6"], "input": "com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-19", "rules": ["IN-6"], "input": "-bad.com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-20", "rules": ["IN-6"], "input": "bad-.com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-21", "rules": ["IN-6"], "input": "under_score.com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-22", "rules": ["IN-6"], "input": "example.123", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-23", "rules": ["IN-6"], "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-24", "rules": ["IN-6"], "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com", "expect": { "ok": true, "domain": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com" } },
    { "id": "N-25", "rules": ["IN-6"], "input": "GENERATE:total_length_254", "note": "Harness generates a syntactically valid name of exactly 254 chars (labels of 63 + dots).", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-26", "rules": ["IN-6"], "input": "GENERATE:total_length_253", "note": "Harness generates a syntactically valid name of exactly 253 chars.", "expect": { "ok": true } },
    { "id": "N-27", "rules": ["IN-7"], "input": "localhost", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-28", "rules": ["IN-7"], "input": "printer.local", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-29", "rules": ["IN-7"], "input": "db.internal", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-30", "rules": ["IN-7"], "input": "router.home.arpa", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-31", "rules": ["IN-7"], "input": "foo.test", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-32", "rules": ["IN-7"], "input": "hidden.onion", "expect": { "ok": false, "error_code": "invalid_domain" } },
    { "id": "N-33", "rules": ["IN-7"], "input": "example.com", "expect": { "ok": true, "domain": "example.com" } },
    { "id": "N-34", "rules": ["IN-6"], "input": "mail.sub.example.co.uk", "expect": { "ok": true, "domain": "mail.sub.example.co.uk" } }
  ]
}
